{
  "name": "ivector-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/cms-local-build.mjs",
    "preview": "node scripts/serve-export.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "cms:setup": "node --env-file-if-exists=.env.local scripts/cms-setup.mjs",
    "cms:check": "node --env-file-if-exists=.env.local scripts/cms-check.mjs",
    "cms:build": "node --env-file-if-exists=.env.local scripts/cms-build.mjs",
    "cms:verify": "node --env-file-if-exists=.env.local scripts/cms-verify.mjs",
    "cms:backup": "node --env-file-if-exists=.env.local scripts/cms-backup.mjs",
    "cms:restore": "node --env-file-if-exists=.env.local scripts/cms-restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@neon/neon-js": "^0.10.2",
    "jose": "^6.2.17",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@neon/config": "^1.14.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.9.3"
  }
}
