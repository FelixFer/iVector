# Only endpoint URLs are public. No credentials, passwords, or owner SQL URL here.
# NEXT_PUBLIC_CMS_AUTH_URL=
# NEXT_PUBLIC_CMS_API_URL=

# Local-only setup/migration connection, with schema and role-creation permissions.
# CMS_SETUP_DATABASE_URL=
# Read-only login granted ivector_cms_reader, for private builds/checks.
# CMS_READ_DATABASE_URL=

# Private build/backup access to the branch's private image bucket.
# CMS_STORAGE_ENDPOINT=
# CMS_STORAGE_REGION=ap-southeast-1
# CMS_STORAGE_BUCKET=
# CMS_STORAGE_ACCESS_KEY_ID=
# CMS_STORAGE_SECRET_ACCESS_KEY=

# Function runtime configuration; put these in Neon Function secrets.
# CMS_DATABASE_URL= (login granted ivector_cms_runtime, never the owner connection)
# CMS_OWNER_ID= (immutable approved Neon Auth user ID)
# CMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:4173
# CMS_BUCKET=
# NEON_AUTH_JWKS_URL= (Neon injects this for the auth-enabled branch)
# NEON_AUTH_BASE_URL= (Neon injects this for the auth-enabled branch)
# Storage credentials are injected by Neon or supplied as CMS_STORAGE_* aliases.

# Backup needs read access to all CMS entries/assets, including drafts.
# CMS_BACKUP_DATABASE_URL=
# Restore only into empty tables on a DIFFERENT test-branch endpoint.
# CMS_RESTORE_DATABASE_URL=
# CMS_RESTORE_STORAGE_ENDPOINT=
# CMS_RESTORE_STORAGE_REGION=ap-southeast-1
# CMS_RESTORE_STORAGE_BUCKET=
# CMS_RESTORE_STORAGE_ACCESS_KEY_ID=
# CMS_RESTORE_STORAGE_SECRET_ACCESS_KEY=
